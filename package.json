{
  "name": "cslockin",
  "version": "0.1.0",
  "description": "LockIn: a grind tracker for CS students on the job hunt. Hosted at cslockin.com.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/ma9197/LockIn" },
  "author": "ma9197",
  "keywords": ["cloudflare-workers", "durable-objects", "leetcode", "job-search", "productivity", "hono"],
  "scripts": {
    "dev": "wrangler dev --port 8787",
